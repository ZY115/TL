TIMED_CHOICE_STAGE(L4, P4, 8, R4, Q4, 10)
END(E)
RULE G(!BAD)
RULE G(L2 -> F(P2 & F(Z2 & F(E))))
RULE G(H -> F[1,3](REC & F(E)))
RULE G(R3 -> ((!Y3) U Q3))
