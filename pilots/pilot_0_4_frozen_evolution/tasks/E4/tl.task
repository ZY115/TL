START(S)
ORDERED_CHOICES(
    (L1 | R1),
    (L2 | R2),
    (L3 | R3),
    (L4 | R4)
)
TIMED_CHOICE_STAGE(L1, P1, 8, R1, Q1, 10)
TIMED_CHOICE_STAGE(L2, P2, 8, R2, Q2, 10)
